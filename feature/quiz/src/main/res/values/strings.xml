<?xml version="1.0" encoding="utf-8"?>
<!--
    A Kvíz képernyők felhasználói szövegei.
    Minden szöveg magyar és KIZÁRÓLAG itt él (NFR-02, FUNCTIONAL_SPEC 8.).
-->
<resources>

    <!-- Beállítás (`quiz/setup`, FUNCTIONAL_SPEC 5.1, FR-11, FR-12, FR-13, FR-22, T-403, T-404). -->

    <string name="quiz_setup_categories_title">Kategóriák</string>
    <!--
        Egy kategória sorának darabszáma: „8 kvízképes / 12 technika" (FUNCTIONAL_SPEC
        5.1/2.). Az első szám a kvízképes, a második az összes (nem visszavont) technika –
        ellentétben a `learn/setup`-pal, ahol csak egy szám van (lásd CONVENTIONS 4.1).
    -->
    <string name="quiz_setup_category_count">%1$d kvízképes / %2$d technika</string>

    <!-- Kérdésszám – szegmentált választó: 5 / 10 / 20 (FUNCTIONAL_SPEC 5.1/3., FR-11). -->
    <string name="quiz_setup_count_title">Kérdésszám</string>

    <!-- Kérdéstípusok (FUNCTIONAL_SPEC 5.1/4., FR-12). A négy felirat szó szerint a
         FUNCTIONAL_SPEC 8. fejezetéből jön (`quiz.type.jpToHu`/`huToJp`/`imageToJp`/
         `jpToImage`). -->
    <string name="quiz_setup_types_title">Kérdéstípusok</string>
    <string name="quiz_setup_type_jp_to_hu">Japán név → magyar jelentés</string>
    <string name="quiz_setup_type_hu_to_jp">Magyar név → japán név</string>
    <string name="quiz_setup_type_image_to_jp">Ábra → japán név</string>
    <string name="quiz_setup_type_jp_to_image">Japán név → ábra</string>

    <!--
        A (C)/(D) képes típus letiltásának indoklása, ha nincs elég validált, kvízben
        használható, egyedi illusztráció (FR-13). A FUNCTIONAL_SPEC 8. szó szerint ezt a
        szöveget adja (`quiz.type.disabled.images`).
    -->
    <string name="quiz_setup_type_disabled_images">Ehhez legalább 4 egyedi, ellenőrzött ábra kell a kiválasztott kategóriákban (jelenleg: %1$d).</string>

    <!--
        Az (A)/(B) szöveges típus letiltásának indoklása, ha nincs elég kvízképes
        technika a négy opcióhoz. A FUNCTIONAL_SPEC csak a képes esetet adja szó szerint
        (fent); ez az analóg, szöveges megfelelője – szándékos kiegészítés, hogy minden
        `SkipReason` kapjon indoklást (T-403 Teendők 3.).
    -->
    <string name="quiz_setup_type_disabled_candidates">Ehhez legalább 4 egyedi, kvízképes technika kell a kiválasztott kategóriákban (jelenleg: %1$d).</string>

    <!--
        A „Kvíz indítása" gomb letiltásának indoklása, ha 0 kérdés állítható össze
        (FUNCTIONAL_SPEC 5.1/5., FR-22). A FUNCTIONAL_SPEC 8. a `quiz.notEnoughData`
        kulcs alatt szó szerint ezt a szöveget adja – egyetlen mondat, amely mindhárom
        javaslatot (kategória, kérdéstípus, kérdésszám) hordozza.
    -->
    <string name="quiz_setup_message_not_enough_data">A kiválasztott beállításokkal nem állítható össze kvíz. Válassz több kategóriát, engedélyezz több kérdéstípust, vagy csökkentsd a kérdésszámot.</string>

    <!--
        Élő készenléti összegzés (FUNCTIONAL_SPEC 5.1/5., FR-11): „A beállításokkal `{n}`
        kérdés állítható össze." – szó szerint a leíró szöveg idézett mondata.
    -->
    <string name="quiz_setup_summary_ready">A beállításokkal %1$d kérdés állítható össze.</string>

    <!--
        Hiány esetén a `quiz.shortfall` kulcs szó szerinti szövege (FUNCTIONAL_SPEC 8.,
        FR-22): „A kért `{k}` helyett `{n}` kérdés lesz, mert nincs több megfelelő
        technika." %1$d a kért, %2$d a tényleges kérdésszám.
    -->
    <string name="quiz_setup_shortfall">A kért %1$d helyett %2$d kérdés lesz, mert nincs több megfelelő technika.</string>

    <string name="quiz_setup_start">Kvíz indítása</string>

    <!-- Futó kvíz (`quiz/run`, FUNCTIONAL_SPEC 5.2, FR-16, FR-17, FR-18, FR-19, T-407, T-409). -->

    <!-- Felső sáv: „{index} / {összes}" (FUNCTIONAL_SPEC 5.2/1.). %1$d az 1-alapú pozíció. -->
    <string name="quiz_run_progress">%1$d / %2$d</string>

    <!-- A bezárás (×) gomb akadálymentes leírása. -->
    <string name="quiz_run_close_a11y">Kvíz megszakítása</string>

    <!-- (A) típus: „Mit jelent: {romaji}?" (FUNCTIONAL_SPEC 5.2/2.). A kérdés tárgya
         (romaji) külön, nagyobb/kiemelt szövegként jelenik meg - lásd `quiz_run_prompt_value`. -->
    <string name="quiz_run_prompt_jp_to_hu_prefix">Mit jelent:</string>
    <!-- (B) típus: „Melyik a japán neve: {magyar}?" (FUNCTIONAL_SPEC 5.2/2.). -->
    <string name="quiz_run_prompt_hu_to_jp_prefix">Melyik a japán neve:</string>
    <!-- A kérdés tárgya (a kiemelt romaji/magyar érték) + a mondatvégi kérdőjel. -->
    <string name="quiz_run_prompt_value">%1$s?</string>

    <!-- (C) típus: „Melyik technika ez?" + illusztráció (FUNCTIONAL_SPEC 5.2/2., T-408).
         Fix mondat, nincs behelyettesített érték – a kérdés tárgya a kép maga. -->
    <string name="quiz_run_prompt_image_to_jp">Melyik technika ez?</string>
    <!-- (D) típus: „Melyik ábra: {romaji}?" (FUNCTIONAL_SPEC 5.2/2., T-408). A kiemelt
         érték a `quiz_run_prompt_value`-val együtt (ugyanaz a kétrészes minta, mint az
         (A)/(B) típusnál). -->
    <string name="quiz_run_prompt_jp_to_image_prefix">Melyik ábra:</string>

    <!-- Válasz-visszajelzés (FUNCTIONAL_SPEC 5.2/4., FUNCTIONAL_SPEC 8. szó szerint). -->
    <string name="quiz_run_answer_correct">Helyes</string>
    <string name="quiz_run_answer_wrong">Helytelen</string>
    <!-- TalkBack `stateDescription` – FUNCTIONAL_SPEC 9. szándékosan kisbetűs, eltérően a
         fent látható, nagybetűs felirattól. -->
    <string name="quiz_run_option_state_correct">helyes</string>
    <string name="quiz_run_option_state_incorrect">helytelen</string>

    <!-- Magyarázó kártya a helyes megoldással (FUNCTIONAL_SPEC 5.2/4., FR-17, US-14). -->
    <string name="quiz_run_explanation_title">Helyes megoldás</string>
    <string name="quiz_run_open_detail">Megnyitás a Tudástárban</string>

    <!-- „Következő" gomb, az utolsó kérdésnél „Eredmény" (FUNCTIONAL_SPEC 5.2/4.). -->
    <string name="quiz_run_next">Következő</string>
    <string name="quiz_run_result">Eredmény</string>

    <!-- Megszakítást megerősítő párbeszéd (FUNCTIONAL_SPEC 5.2/5., FUNCTIONAL_SPEC 8.
         szó szerint: `quiz.abort.title`/`quiz.abort.message`). A gombfeliratok
         („Megszakítás"/„Folytatás") az 5.2 leíró szövegéből jönnek szó szerint. -->
    <string name="quiz_run_abort_title">Megszakítod a kvízt?</string>
    <string name="quiz_run_abort_message">Az eddigi válaszaid megmaradnak.</string>
    <string name="quiz_run_abort_confirm">Megszakítás</string>
    <string name="quiz_run_abort_dismiss">Folytatás</string>

    <!-- Védelmi háló (NFR-06): a terv sérült/üres, vagy egy opció technikája nem
         található. A `quiz/setup` normál esetben nem engedi ide eljutni a felhasználót. -->
    <string name="quiz_run_empty_message">A kvízhez nem sikerült betölteni a kérdéseket.</string>
    <string name="quiz_run_empty_action">Vissza a beállításokhoz</string>

    <!-- Eredmény (`quiz/result`, FUNCTIONAL_SPEC 5.3, FR-20, FR-21, FR-27, T-411, T-412, T-415). -->

    <!-- Nagy összegzés: „{helyes} / {megválaszolt} helyes" (FUNCTIONAL_SPEC 5.3/1. szó
         szerint idézve). %1$d a helyes, %2$d a megválaszolt kérdésszám. -->
    <string name="quiz_result_score_fraction">%1$d / %2$d helyes</string>
    <!-- A sikerarány szövegesen is kiolvasható, nem csak diagramon (NFR-04, T-411
         „Kész ha"). %1$d egész szám, 0–100 között. -->
    <string name="quiz_result_score_percent">Sikerarány: %1$d%%</string>

    <!-- 0 válasz esetén (FUNCTIONAL_SPEC 5.3/1., FR-27, FUNCTIONAL_SPEC 8. `quiz.result.noAnswers`
         szó szerint). -->
    <string name="quiz_result_no_answers">Nem válaszoltál egyetlen kérdésre sem.</string>

    <!-- Megszakított kvíz esetén (FUNCTIONAL_SPEC 5.3/1. szó szerint, FR-19). %1$d a
         megválaszolt, %2$d a kért kérdésszám. -->
    <string name="quiz_result_aborted">Megszakított kvíz – %1$d / %2$d kérdés.</string>

    <!-- Hibás kérdések listája (FUNCTIONAL_SPEC 5.3/2.). -->
    <string name="quiz_result_wrong_title">Hibás kérdések</string>
    <string name="quiz_result_wrong_correct_label">Helyes megoldás:</string>
    <string name="quiz_result_wrong_selected_label">A válaszod:</string>

    <!-- Gombok (FUNCTIONAL_SPEC 5.3/3. szó szerint; a `quiz.result.retryWrong` kulcs a
         FUNCTIONAL_SPEC 8. fejezetében is szó szerint szerepel). -->
    <string name="quiz_result_retry_wrong">Hibák újragyakorlása</string>
    <string name="quiz_result_new_quiz">Új kvíz</string>
    <string name="quiz_result_back_to_progress">Vissza a Haladáshoz</string>

    <!-- Védelmi háló (NFR-06): a menet nem található (pl. törölt haladás). -->
    <string name="quiz_result_not_found_message">A kvízmenet nem található.</string>

