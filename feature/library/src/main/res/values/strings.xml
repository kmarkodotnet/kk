<?xml version="1.0" encoding="utf-8"?>
<!--
    A Tudástár képernyők felhasználói szövegei.
    Minden szöveg magyar és KIZÁRÓLAG itt él (NFR-02, FUNCTIONAL_SPEC 8.).
-->
<resources>

    <!-- Keresősáv (FUNCTIONAL_SPEC 3.1 és 8.: `library.search.hint`). -->
    <string name="library_search_hint">Keresés romaji vagy magyar név szerint</string>
    <string name="library_search_clear">Keresés törlése</string>

    <!--
        Kategóriaszűrő. Az „Összes" chip a kijelölésmentes állapot – a ViewModelben ez az
        üres halmaz, nem egy külön kategória (FR-02).
    -->
    <string name="library_filter_all">Összes</string>
    <!-- A chip találatszáma: a kategória magyar neve mellett zárójelben. -->
    <string name="library_filter_count">%1$s (%2$d)</string>

    <!--
        Alias alapú találat jelzése (US-06 3. kritérium, FUNCTIONAL_SPEC 3.1).

        Csak akkor jelenik meg, ha a repository megmondta, melyik alias illeszkedett
        (`TechniqueMatch.matchedAlias`) – a UI ezt nem találja ki.
    -->
    <string name="library_matched_alias">Egyezés: %1$s</string>

    <!--
        Részletező képernyő (FUNCTIONAL_SPEC 3.2, FR-04, FR-05, US-07, US-08).
    -->

    <!-- Aliasok felsorolása (3.2. 6. pont: „Más néven: …"). -->
    <string name="library_detail_aliases">Más néven: %1$s</string>

    <!--
        US-08 3. kritérium: a „Hiányos rekord" blokk a `VerificationBadge`-ből jön
        (a „Hiányos" jelölő + a hiányzó mezők felsorolása, FUNCTIONAL_SPEC 2.2); ez a
        szöveg a HARMADIK, önálló elem, amit a kritérium külön megkövetel: a
        kvízkizárás ténye.
    -->
    <string name="library_detail_quiz_excluded_notice">Ez a rekord hiányos, ezért nem használható kvízkérdésben.</string>

    <!--
        A technika nem létezik a betöltött tudástárban (FUNCTIONAL_SPEC 10.) – a
        `TechniqueRepository.getTechnique` dokumentált `null` ága. A gyakorlatban nem
        fordul elő, mert a részletező csak a listáról nyitható meg, de nem omolhat
        össze, ha mégis ismeretlen azonosítóval hívják.
    -->
    <string name="library_detail_not_found">Ez a technika nem található a tudástárban.</string>

</resources>
